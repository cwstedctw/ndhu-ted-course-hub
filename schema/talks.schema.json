{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.ndhu-ted/schema/talks.schema.json",
  "title": "talks.json — 演講課 12 場",
  "type": "object",
  "additionalProperties": false,
  "required": ["courseDir", "moeIndicators", "talks"],
  "properties": {
    "courseDir": { "const": "11501-ai-future" },
    "moeIndicators": {
      "$comment": "上限＝負責任 AI 六面向的個數（2026-07-20 由三指標改六面向時漏改，補上）",
      "type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true,
      "items": { "$ref": "_defs.schema.json#/$defs/moeIndicator" }
    },
    "talks": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": { "$ref": "#/$defs/talk" }
    }
  },
  "$defs": {
    "talk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "no", "status", "date", "time", "venue", "title", "speaker",
                   "abstract", "moe", "poster", "worksheetUrl", "materials"],
      "properties": {
        "id": { "type": "string", "pattern": "^t(0[1-9]|1[0-2])$" },
        "no": { "type": "integer", "minimum": 1, "maximum": 12 },
        "status": { "enum": ["confirmed", "tba", "done"] },
        "date": { "$ref": "_defs.schema.json#/$defs/nullableIsoDate" },
        "time": { "$ref": "_defs.schema.json#/$defs/nullableHhmmTime" },
        "venue": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "speaker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "title", "org", "photo", "links"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "title": { "type": ["string", "null"] },
            "org": { "type": ["string", "null"] },
            "photo": { "anyOf": [ { "type": "string", "pattern": "^/images/talks/" }, { "type": "null" } ] },
            "bio": {
              "description": "講者簡介（v3 新增，2026-07-25，optional／可 null）。缺／null＝海報牆不出簡介段",
              "type": ["string", "null"]
            },
            "links": { "anyOf": [ { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 20 }, "url": { "$ref": "_defs.schema.json#/$defs/httpsUrl" } } } }, { "type": "null" } ] }
          }
        },
        "abstract": { "type": ["string", "null"] },
        "moe": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "_defs.schema.json#/$defs/moeIndicator" }
        },
        "poster": { "anyOf": [ { "type": "string", "pattern": "^/images/talks/" }, { "type": "null" } ] },
        "worksheetUrl": { "$ref": "_defs.schema.json#/$defs/nullableHttpsUrl" },
        "week": {
          "description": "對應課程第幾週（v3 新增，2026-07-25，optional／可 null）。缺／null＝尚未排定對應週次",
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 18 },
            { "type": "null" }
          ]
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "$ref": "_defs.schema.json#/$defs/httpsUrl" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["confirmed", "done"] } } },
          "then": {
            "$comment": "confirmed＝『講者敲定』，不等於講題／單位都到齊。title 與 speaker.org 允許 null：顯示層本來就有 fallback（海報牆「講題公布中」、單位缺就不印那一段），硬要求會逼人先填假資料。date、speaker.name、moe 仍是硬條件。",
            "properties": {
              "date": { "type": "string" },
              "speaker": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 1 }
                }
              },
              "moe": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
