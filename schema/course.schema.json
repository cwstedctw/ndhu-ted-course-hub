{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.ndhu-ted/schema/course.schema.json",
  "title": "course.json — 課程詳細（course-intro.json 超集＋hub）",
  "type": "object",
  "required": ["id", "kind", "name", "nameEn", "semester", "org", "instructor",
               "credits", "courseType", "weeksSystem", "sections", "intro", "meta", "hub"],
  "properties": {
    "kind": { "enum": ["regular", "lecture-series"] },
    "semester": { "$ref": "_defs.schema.json#/$defs/semester" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "schedule": {
            "description": "結構化課表資料（v3 新增，2026-07-25，optional／可 null）。不動既有 time 字串（顯示層仍用 time）；schedule 供之後結構化排程／週曆功能用。缺／null＝尚未結構化。",
            "anyOf": [
              { "$ref": "#/$defs/sectionSchedule" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "intro": {
      "type": "object",
      "properties": { "internalNotes": false }
    },
    "hub": { "$ref": "#/$defs/hub" },
    "en": {
      "type": "object",
      "description": "emi 外籍生班英文層（2026-08-02 重整 R5）；正本＝英文版教學計畫，只覆蓋決策卡／課前準備／評分摘要",
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "tagline": { "type": ["string", "null"] },
        "timeLine": { "type": ["string", "null"] },
        "gradingLine": { "type": ["string", "null"] },
        "whatToBring": { "type": "array", "items": { "type": "string" } },
        "platformUse": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sectionSchedule": {
      "description": "day：1–7 整數，1＝週一……7＝週日（ISO 8601 曜日編號）；periods：[起,迄] 節次整數，對應既有 time 字串「第 A–B 節」",
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "periods", "startTime", "endTime", "room"],
      "properties": {
        "day": { "type": "integer", "minimum": 1, "maximum": 7 },
        "periods": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1, "maximum": 20 }
        },
        "startTime": { "$ref": "_defs.schema.json#/$defs/hhmmTime" },
        "endTime": { "$ref": "_defs.schema.json#/$defs/hhmmTime" },
        "room": { "type": "string", "minLength": 1 }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["links", "showcaseRefs", "heroImage", "showPromptButtons"],
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "use", "label", "url", "urlStatus"],
            "properties": {
              "platform": { "enum": ["teams", "zuvio", "hackmd", "elearn", "classroom", "other"] },
              "use": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "url": { "$ref": "_defs.schema.json#/$defs/nullableHttpsUrl" },
              "urlStatus": { "enum": ["pending", "confirmed"] }
            },
            "allOf": [
              {
                "if": { "properties": { "urlStatus": { "const": "confirmed" } } },
                "then": { "properties": { "url": { "type": "string" } } }
              },
              {
                "if": { "properties": { "url": { "type": "null" } } },
                "then": { "properties": { "urlStatus": { "const": "pending" } } }
              }
            ]
          }
        },
        "scoreUrl": { "$ref": "_defs.schema.json#/$defs/nullableScoreV2Url" },
        "showcaseRefs": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*-\\d{2}$" }
        },
        "heroImage": {
          "anyOf": [ { "type": "string", "pattern": "^/images/courses/" }, { "type": "null" } ]
        },
        "showPromptButtons": { "type": "boolean" }
      }
    }
  }
}
