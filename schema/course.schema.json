{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.ndhu-ted/schema/course.schema.json",
  "title": "course.json — 課程詳細（course-intro.json 超集＋hub）",
  "type": "object",
  "required": ["id", "kind", "name", "nameEn", "semester", "org", "instructor",
               "credits", "courseType", "weeksSystem", "sections", "intro", "meta", "hub"],
  "properties": {
    "kind": { "enum": ["regular", "lecture-series"] },
    "semester": { "$ref": "_defs.schema.json#/$defs/semester" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "langProfile": { "$ref": "#/$defs/langProfile" },
          "scheduleNote": { "type": ["string", "null"] }
        }
      }
    },
    "intro": {
      "type": "object",
      "properties": { "internalNotes": false }
    },
    "en": {
      "$comment": "英文鏡像子樹（班別語言 profile 用）。形狀刻意保持開放——真正的完整性由 validate 規則 #20 的必填清單逐條把關（fail-closed），schema 只擋明顯的型別錯誤。",
      "type": "object",
      "properties": { "internalNotes": false }
    },
    "hub": { "$ref": "#/$defs/hub" }
  },
  "$defs": {
    "langProfile": {
      "$comment": "班別語言 profile（2026-08-26，工單第 21 項）。primary＝該班主要語言；support＝並列的支援語言；mode 是兩者的組合方式。AA＝en 主＋zh-Hant-TW 支援（雙欄，不是 en-only）；AB＝zh-Hant-TW 主＋English 技術名詞。宣告了 primary=en，就必須備齊 en 子樹與 site.i18n.en 字典，缺一條 validate #20 直接擋 build。",
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "support", "mode"],
      "properties": {
        "primary": { "enum": ["en", "zh-Hant-TW"] },
        "support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["en", "zh-Hant-TW"] }
        },
        "mode": { "enum": ["en-primary-zh-support", "zh-primary-en-terms"] },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "primary": { "const": "en" } }, "required": ["primary"] },
          "then": {
            "properties": {
              "mode": { "const": "en-primary-zh-support" },
              "support": { "type": "array", "contains": { "const": "zh-Hant-TW" } }
            }
          }
        },
        {
          "if": { "properties": { "primary": { "const": "zh-Hant-TW" } }, "required": ["primary"] },
          "then": {
            "properties": {
              "mode": { "const": "zh-primary-en-terms" },
              "support": { "type": "array", "contains": { "const": "en" } }
            }
          }
        }
      ]
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["links", "showcaseRefs", "heroImage", "coursePoster", "showPromptButtons"],
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "use", "label", "url", "urlStatus"],
            "properties": {
              "platform": { "enum": ["teams", "zuvio", "hackmd", "elearn", "classroom", "other"] },
              "use": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "url": { "$ref": "_defs.schema.json#/$defs/nullableHttpsUrl" },
              "urlStatus": { "enum": ["pending", "confirmed", "none"] }
            },
            "allOf": [
              {
                "if": { "properties": { "urlStatus": { "const": "confirmed" } } },
                "then": { "properties": { "url": { "type": "string" } } }
              },
              {
                "if": { "properties": { "url": { "type": "null" } } },
                "then": { "properties": { "urlStatus": { "enum": ["pending", "none"] } } }
              }
            ]
          }
        },
        "scoreUrl": { "$ref": "_defs.schema.json#/$defs/nullableScoreV2Url" },
        "showcaseRefs": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d{4}-[a-z0-9]+(-[a-z0-9]+)*-\\d{2}$" }
        },
        "heroImage": {
          "anyOf": [ { "type": "string", "pattern": "^/images/courses/" }, { "type": "null" } ]
        },
        "coursePoster": {
          "$comment": "整門課一張的總海報（螢幕版 WebP）。由 talk-course-manager/scripts/make_course_poster.py 產、過六道閘門後才放進來；null＝這門課沒有總海報。",
          "anyOf": [ { "type": "string", "pattern": "^/images/courses/" }, { "type": "null" } ]
        },
        "showPromptButtons": { "type": "boolean" }
      }
    }
  }
}
